# ── ViralHook Backend — Dockerfile ────────────────────────────────────────────
# Multi-stage build:
#   Stage 1 (builder): install all Python dependencies
#   Stage 2 (runtime): copy only what's needed — smaller final image

# ── Stage 1: Builder ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /app

# System dependencies for FFmpeg, audio processing, and OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for Docker layer caching
COPY module1_style_extraction/requirements.txt ./requirements.txt

# Install Python dependencies
# CPU-only torch wheels: the default Linux torch pulls ~2.5GB of CUDA libs,
# which the multi-stage copy doubles — enough to exhaust CI runner disk.
# torchvision is pinned to match torch 2.2.2, otherwise open-clip-torch
# pulls the latest torchvision, which upgrades torch.
# openai-whisper==20231117 is sdist-only and its setup.py imports
# pkg_resources, which setuptools>=81 removed — constrain the build env.
RUN pip install --no-cache-dir --upgrade pip && \
    echo "setuptools<81" > /tmp/build-constraints.txt && \
    pip install --no-cache-dir \
        --build-constraint /tmp/build-constraints.txt \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        -r requirements.txt \
        torchvision==0.17.2 && \
    pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        open-clip-torch==2.24.0 \
        scenedetect[opencv]==0.6.4 \
        librosa==0.10.2 \
        soundfile==0.12.1 \
        qdrant-client==1.9.1


# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

WORKDIR /app

# Runtime system dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY server.py .
COPY pipeline/ ./pipeline/
COPY module1_style_extraction/ ./module1_style_extraction/
COPY module2_multimodal_rag/ ./module2_multimodal_rag/

# Create required directories
RUN mkdir -p module1_style_extraction/input_videos \
             module1_style_extraction/temp_audio \
             module2_multimodal_rag

# Expose FastAPI port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Run uvicorn
CMD ["python", "-m", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
