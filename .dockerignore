# ── ViralHook .dockerignore ────────────────────────────────────────────────────
# Prevents large/sensitive files from being sent to Docker build context

# Python virtual environments (never include in image)
.venv/
venv/
module1_style_extraction/venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.Python

# Node modules (rebuilt inside Docker)
node_modules/
frontend_extracted/frontend/node_modules/

# Build outputs
frontend_extracted/frontend/dist/
*.egg-info/
dist/
build/

# Large model/data files
module1_style_extraction/input_videos/
module1_style_extraction/temp_audio/
pipeline/cache/

# Sensitive files — use environment variables instead
.env
module1_style_extraction/.env
**/.env

# Git
.git/
.gitignore

# Test files (not needed in production image)
tests/

# IDE
.vscode/
.idea/
*.kiro

# OS
.DS_Store
Thumbs.db

# Logs
*.log
