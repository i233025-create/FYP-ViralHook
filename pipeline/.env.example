# ─── Pipeline Environment Variables ─────────────────────────────────────────
# Copy to .env and fill in your values.
# Place this file at: fyp poc/module1_style_extraction/.env (shared with module1)

# Groq API key — get free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# YouTube Data API v3 key — get free key at https://console.cloud.google.com
# Enable "YouTube Data API v3" and create an API key credential.
# Free quota: 10,000 units/day (~9 full research runs per day, ~1,010 units each)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Research Agent data source: youtube (V1, default) or instagram (V2)
TREND_SOURCE=youtube

# Instagram (V2) — Instagram Graph API with Facebook Login.
# Meta developer app (development mode) + your Instagram Business/Creator account
# linked to a Facebook Page. Token: Graph API Explorer with instagram_basic,
# instagram_manage_insights, business_management +
# pages_show_list (+ pages_read_engagement), then exchange for a 60-day token.
# IG_USER_ID: GET /me/accounts?fields=instagram_business_account
IG_ACCESS_TOKEN=
IG_USER_ID=
# 15-30 Business/Creator accounts in your niche (personal accounts are skipped)
IG_CREATORS=creator_one,creator_two,creator_three
# Optional; empty = built from the search queries. Max 30 new hashtags / 7 days.
IG_HASHTAGS=
IG_GRAPH_VERSION=v23.0

# Optional trend-definition thresholds (defaults shown)
# TREND_OVERPERFORM_OUTLIER=1.5
# TREND_GROWTH_RATIO_MIN=1.3
# TREND_MIN_TREND_CHANNELS=3
# TREND_RECENT_WINDOW_DAYS=3

# LLM provider for the Research + Scripting agents: ollama (local, default) or groq
LLM_PROVIDER=ollama

# Local LLM (Ollama). Install https://ollama.com then: ollama pull qwen2.5:3b
# Research Agent works without it (non-LLM fallbacks); Scripting Agent needs it.
# CPU-only / 8 GB RAM laptop: qwen2.5:1.5b. 4 GB GPU: qwen2.5:3b (or 7b, slower).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional bigger model just for script writing (must belong to LLM_PROVIDER),
# e.g. SCRIPT_MODEL=qwen2.5:7b on the GPU laptop. Empty = OLLAMA_MODEL.
SCRIPT_MODEL=

# Only if LLM_PROVIDER=groq (uses GROQ_API_KEY above)
GROQ_MODEL=openai/gpt-oss-20b
