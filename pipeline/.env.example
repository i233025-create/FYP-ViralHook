# ─── Pipeline Environment Variables ─────────────────────────────────────────
# Copy to .env and fill in your values.
# Place this file at: fyp poc/module1_style_extraction/.env (shared with module1)

# Groq API key — get free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# YouTube Data API v3 key — get free key at https://console.cloud.google.com
# Enable "YouTube Data API v3" and create an API key credential.
# Free quota: 10,000 units/day (~19 full pipeline runs per day)
YOUTUBE_API_KEY=your_youtube_api_key_here

# LLM provider for the Research + Scripting agents: ollama (local, default) or groq
LLM_PROVIDER=ollama

# Local LLM (Ollama). Install https://ollama.com then: ollama pull qwen2.5:3b
# Research Agent works without it (non-LLM fallbacks); Scripting Agent needs it.
# CPU-only / 8 GB RAM laptop: qwen2.5:1.5b. 4 GB GPU: qwen2.5:3b (or 7b, slower).
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional bigger model just for script writing (must belong to LLM_PROVIDER),
# e.g. SCRIPT_MODEL=qwen2.5:7b on the GPU laptop. Empty = OLLAMA_MODEL.
SCRIPT_MODEL=

# Only if LLM_PROVIDER=groq (uses GROQ_API_KEY above)
GROQ_MODEL=openai/gpt-oss-20b
