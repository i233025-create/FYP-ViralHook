# ─── Pipeline Environment Variables ─────────────────────────────────────────
# Copy to .env and fill in your values.
# Place this file at: fyp poc/module1_style_extraction/.env (shared with module1)

# Groq API key — get free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# YouTube Data API v3 key — get free key at https://console.cloud.google.com
# Enable "YouTube Data API v3" and create an API key credential.
# Free quota: 10,000 units/day (~19 full pipeline runs per day)
YOUTUBE_API_KEY=your_youtube_api_key_here
