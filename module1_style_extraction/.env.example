# ─── Environment Variables for Module 1 (also read by the pipeline agents) ──
# Copy this file to .env and fill in your actual values.
#   Windows: copy .env.example .env

# LLM provider: ollama (local, default — no API key) or groq (cloud, optional)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
# CPU-only / 8 GB RAM: qwen2.5:1.5b   ·   4 GB GPU: qwen2.5:3b (better)
OLLAMA_MODEL=qwen2.5:3b

# Only needed if LLM_PROVIDER=groq. Free key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Research Agent — YouTube Data API v3 key (free, 10,000 units/day)
YOUTUBE_API_KEY=your_youtube_api_key_here
