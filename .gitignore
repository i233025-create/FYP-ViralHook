# ── ViralHook .gitignore ───────────────────────────────────────────────────────

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
module1_style_extraction/venv/
*.egg-info/
dist/
build/
.eggs/

# ── Environment / Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.production
module1_style_extraction/.env
**/.env

# ── Large model files ─────────────────────────────────────────────────────────
# Whisper models (downloaded at runtime)
*.pt
*.pth
*.bin

# HuggingFace cache
.cache/

# ── Input / temporary files ───────────────────────────────────────────────────
module1_style_extraction/input_videos/
module1_style_extraction/temp_audio/
pipeline/cache/

# ── Vector DB ─────────────────────────────────────────────────────────────────
# ChromaDB — regenerated by running module1/main.py
chroma_db/
module1_style_extraction/chroma_db/

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend_extracted/frontend/node_modules/
frontend_extracted/frontend/dist/
.npm

# ── Test artifacts ────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.coverage
coverage.xml

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.kiro/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Docker ────────────────────────────────────────────────────────────────────
# Don't ignore docker files themselves, just runtime artifacts
.docker/

# ── Zip archives ──────────────────────────────────────────────────────────────
*.zip
frontend.zip
